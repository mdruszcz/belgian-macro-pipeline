{
  "registry_version": 1,
  "forward_compatibility": "Batch 10 (the shared renderer) may ADD keys to this file -- new block types, new versions of an existing type, new per-type keys, new entries under $defs. It may NOT change or remove anything Batch 9 wrote here: no renaming a block type or a prop, no narrowing an existing props schema, no dropping a version from supported_versions. A prop shape has to change? Add a new block version and a migration step in src/pages/migrations.py; the old version keeps rendering. Bump registry_version only when that rule itself has to be broken, which needs an ADR.",
  "accessible_name_note": "A block type with interactive: true MUST carry a trilingual accessible_name prop. That is enforced by src/pages/semantics.py so the failure reports as `missing_accessible_name`; the props schemas below deliberately do not list it under `required`, because a schema `required` would report it as `schema_violation` instead.",
  "props_schema_note": "Every props schema below is marked props_schema_status: \"provisional\". Batch 9 defines the document format; no block here has been rendered yet, so prop shapes are not frozen. Batch 10 tightens them by adding a version, not by editing one.",
  "deliberately_absent": {
    "news_card": "no content source exists in this repository.",
    "simulated_live_counter": "Batch 2 made it throw without data-simulated=\"true\"; its contract belongs to Batch 10.",
    "page_shell_and_sidebars": "layout chrome, not document content; Batch 10/13."
  },
  "reversals": {
    "ranking_list": "Was listed above as needing the unbuilt Peer Model. Half of that was true. A NAMED composite rank (\"economic dynamism\") does need it; a per-indicator rank does not -- percentile.national.rank has shipped in every commune payload since Batch 14. Added for the commune profile, rendering the rank that exists and saying what a composite one is waiting for. Recorded here rather than deleted, so the reasoning that changed is visible."
  },
  "$defs": {
    "trilingual_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "fr",
        "nl"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "nl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relative_url": {
      "description": "Site-relative path or in-page fragment only. No scheme, no host, no protocol-relative //host (claude.md rule 23). src/pages/semantics.py additionally rejects '..' and '//' in any URL-bearing prop.",
      "type": "string",
      "pattern": "^(/[A-Za-z0-9._~/-]*|#[A-Za-z0-9_-]+)$"
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/trilingual_text"
        },
        "href": {
          "$ref": "#/$defs/relative_url"
        }
      }
    },
    "rich_text_node": {
      "description": "An allowlisted node set expressed in the schema, NOT a sanitiser over raw HTML. There is no node that carries markup.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "text"
          ],
          "properties": {
            "node": {
              "const": "paragraph"
            },
            "text": {
              "$ref": "#/$defs/trilingual_text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "level",
            "text"
          ],
          "properties": {
            "node": {
              "const": "heading"
            },
            "level": {
              "enum": [
                2,
                3,
                4
              ]
            },
            "text": {
              "$ref": "#/$defs/trilingual_text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "items"
          ],
          "properties": {
            "node": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/trilingual_text"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "text",
            "href"
          ],
          "properties": {
            "node": {
              "const": "link"
            },
            "text": {
              "$ref": "#/$defs/trilingual_text"
            },
            "href": {
              "$ref": "#/$defs/relative_url"
            }
          }
        }
      ]
    }
  },
