    "ranking_list": {
      "accepts_binding": true,
      "props_schema_status": "provisional",
      "current_version": 2,
      "interactive": false,
      "reuses": "assets/belpulse/components.css -- .bp-ranking-list, .bp-ranking-item.",
      "requires_binding": false,
      "supported_versions": [
        1,
        2
      ],
      "why_in_batch_9": "was listed under deliberately_absent, on the grounds that it needs the unbuilt Peer Model. Half of that is true: a NAMED composite rank does. A per-indicator rank does not -- percentile.national.rank ships in every commune payload today -- so the block renders that from a `percentile` binding, and a composite row says what it is waiting for.",
      "versions": {
        "1": {
          "props_schema_status": "provisional",
          "props_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/trilingual_text"
              },
              "scope": {
                "enum": [
                  "national",
                  "regional"
                ]
              }
            }
          }
        },
        "2": {
          "props_schema_status": "provisional",
          "props_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/trilingual_text"
              },
              "scope": {
                "enum": [
                  "national",
                  "regional"
                ]
              },
              "title": {
                "description": "A heading for a GROUP of ranking blocks. The design's sidebar panel is one title over several ranks, and a block carries one binding, so the title goes on the first block of the group and the rest are seamed to it by the stylesheet.",
                "$ref": "#/$defs/trilingual_text"
              },
              "unavailable_reason": {
                "description": "What to say instead of the generic 'not available for this selection'. A composite rank waits on the Peer Model; saying so is worth more to a reader than the state machine's own sentence.",
                "$ref": "#/$defs/trilingual_text"
              }
            }
          }
        }
      },
      "why_v2": "the design's sidebar is ONE panel of several ranks under one heading, and a block carries one binding -- so the panel is several blocks. v2 adds an optional `title` for the first of them; without it the heading had to be a separate card, which is exactly the looseness this pass removed."
    },
