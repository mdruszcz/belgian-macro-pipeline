{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://belgian-macro-pipeline/source_config.schema.json",
  "title": "Source configuration",
  "type": "object",
  "required": ["source_id", "name", "agency", "adapter", "is_active"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "agency": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "enum": ["nbb", "dbnomics", "fpb"] },
    "base_url": { "type": ["string", "null"] },
    "licence": { "type": ["string", "null"] },
    "catalog_ref": { "type": ["string", "null"] },
    "cadence": { "type": ["string", "null"] },
    "is_active": { "type": "boolean" }
  }
}
