{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://belgian-macro-pipeline/indicator_config.schema.json",
  "title": "Indicator configuration",
  "type": "object",
  "required": [
    "id",
    "name",
    "unit",
    "frequency",
    "source_id",
    "geo_levels",
    "preferred_direction",
    "display"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "name": {
      "type": "object",
      "required": [
        "en",
        "fr",
        "nl"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "nl": {
          "type": "string"
        }
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "frequency": {
      "type": "string",
      "enum": [
        "A",
        "Q",
        "M",
        "F"
      ]
    },
    "max_age_days": {
      "type": "integer",
      "minimum": 1,
      "description": "Staleness allowance for the validation layer (Block H): days past the end of the latest period before the `staleness` rule warns. Omit unless the frequency default is wrong -- set it only to record a known, verified reason the series is frozen, so the warning still means something when that changes."
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "geo_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "national",
          "regional",
          "provincial",
          "municipal"
        ]
      }
    },
    "preferred_direction": {
      "type": "string",
      "enum": [
        "lower_is_better",
        "higher_is_better",
        "neutral",
        "contextual"
      ]
    },
    "country": {
      "type": "string",
      "description": "Country/aggregate this series describes (informational, not a strict ISO code -- 'EA' etc. are allowed). Omit for Belgium; the loader defaults to 'BE'. This is what determines canonical-schema/dashboard eligibility, not whether `display` is null -- e.g. EC_CONS_CONF_BE is Belgian data with no dashboard row of its own, and is still eligible."
    },
    "fetch": {
      "type": "object",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "display": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "category",
            "title",
            "sort_order"
          ],
          "additionalProperties": false,
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "gdp",
                "confidence",
                "prices",
                "labour",
                "employment",
                "unemployment",
                "business",
                "fiscal"
              ]
            },
            "title": {
              "type": "object",
              "required": [
                "en",
                "fr",
                "nl"
              ],
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string"
                },
                "fr": {
                  "type": "string"
                },
                "nl": {
                  "type": "string"
                }
              }
            },
            "description": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "en": {
                  "type": "string"
                },
                "fr": {
                  "type": "string"
                },
                "nl": {
                  "type": "string"
                }
              }
            },
            "sort_order": {
              "type": "number"
            },
            "sdmx_code": {
              "type": "string"
            },
            "combined": {
              "type": "boolean"
            },
            "forecast_of": {
              "type": "string",
              "enum": [
                "GDP_VOL",
                "CPI",
                "FISCAL_BAL"
              ]
            }
          }
        }
      ]
    },
    "transform": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "rebase"
          ]
        },
        "base": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
